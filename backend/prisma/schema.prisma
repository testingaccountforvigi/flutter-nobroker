// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AccountIntent {
  SEEKER
  OWNER
  BOTH
}

enum PropertyPurpose {
  RENT
  BUY
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  PG
  STUDIO
  OTHER
}

enum FurnishingType {
  FULLY_FURNISHED
  SEMI_FURNISHED
  UNFURNISHED
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  PAUSED
  RENTED
  SOLD
  ARCHIVED
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

enum VisitStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
}

enum CallStatus {
  INITIATED
  RINGING
  ACCEPTED
  MISSED
  DECLINED
  COMPLETED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  AADHAAR
  PAN
  DRIVING_LICENSE
  PASSPORT
  VOTER_ID
  OTHER
}

enum AgreementStatus {
  DRAFT
  PENDING_SIGNATURE
  COMPLETED
  CANCELLED
}

enum MovingRequestStatus {
  PENDING
  QUOTED
  BOOKED
  COMPLETED
  CANCELLED
}

enum MoverQuoteStatus {
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum BookingStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReminderType {
  RENT
  NOTICE_PERIOD
  AGREEMENT
  CUSTOM
}

enum PremiumOrderStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum NotificationType {
  INQUIRY
  CALL
  VISIT
  AGREEMENT
  REMINDER
  VERIFICATION
  PREMIUM
  SYSTEM
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  role         UserRole      @default(USER)
  intent       AccountIntent @default(SEEKER)
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  refreshTokens       RefreshToken[]
  ownedProperties     Property[]           @relation("PropertyOwner")
  favorites           Favorite[]
  propertyViews       PropertyView[]
  sentInquiries       Inquiry[]            @relation("InquirySender")
  receivedInquiries   Inquiry[]            @relation("InquiryReceiver")
  sentVisitRequests   VisitRequest[]       @relation("VisitSender")
  receivedVisitRequests VisitRequest[]     @relation("VisitReceiver")
  callsMade           Call[]               @relation("CallCaller")
  callsReceived       Call[]               @relation("CallReceiver")
  verificationRequest VerificationRequest?
  ownedAgreements     Agreement[]          @relation("AgreementOwner")
  tenantAgreements    Agreement[]          @relation("AgreementTenant")
  agreementSignatures AgreementSignature[]
  movingRequests      MovingRequest[]
  reminders           Reminder[]
  premiumOrders       PremiumOrder[]
  reportsMade         Report[]             @relation("Reporter")
  reportsAgainst      Report[]             @relation("ReportedUser")
  notifications       InAppNotification[]
  auditLogs           AuditLog[]

  @@index([email])
  @@index([role])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model Property {
  id                       String          @id @default(uuid())
  ownerId                  String
  title                    String
  description              String          @db.Text
  purpose                  PropertyPurpose
  type                     PropertyType
  address                  String
  locality                 String
  city                     String
  state                    String
  postalCode               String
  latitude                 Float?
  longitude                Float?
  price                    Float
  securityDeposit          Float?
  areaSqFt                 Int
  bedrooms                 Int
  bathrooms                Int
  balconies                Int             @default(0)
  furnishing               FurnishingType
  floor                    Int?
  totalFloors              Int?
  availableFrom            DateTime
  status                   PropertyStatus  @default(DRAFT)
  isVerifiedOwnerSnapshot  Boolean         @default(false)
  isPremium                Boolean         @default(false)
  premiumUntil             DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  // Relations
  owner            User                @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  photos           PropertyPhoto[]
  floorPlan        FloorPlan?
  amenities        PropertyAmenity[]
  favorites        Favorite[]
  views            PropertyView[]
  inquiries        Inquiry[]
  visitRequests    VisitRequest[]
  calls            Call[]
  agreements       Agreement[]
  premiumOrders    PremiumOrder[]
  reports          Report[]

  @@index([ownerId])
  @@index([city])
  @@index([locality])
  @@index([purpose])
  @@index([status])
  @@index([isPremium])
  @@index([price])
  @@index([availableFrom])
  @@index([createdAt])
}

model PropertyPhoto {
  id         String  @id @default(uuid())
  propertyId String
  url        String
  roomTag    String?
  sortOrder  Int     @default(0)
  isCover    Boolean @default(false)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([isCover])
}

model FloorPlan {
  id               String  @id @default(uuid())
  propertyId       String  @unique
  url              String
  measurementsText String? @db.Text

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Amenity {
  id         String            @id @default(uuid())
  name       String            @unique
  icon       String?
  properties PropertyAmenity[]
}

model PropertyAmenity {
  propertyId String
  amenityId  String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@index([propertyId])
  @@index([amenityId])
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

model PropertyView {
  id         String   @id @default(uuid())
  userId     String?
  propertyId String
  createdAt  DateTime @default(now())

  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([propertyId])
  @@index([createdAt])
}

model Inquiry {
  id         String        @id @default(uuid())
  propertyId String
  seekerId   String
  ownerId    String
  message    String        @db.Text
  status     InquiryStatus @default(NEW)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  seeker   User     @relation("InquirySender", fields: [seekerId], references: [id], onDelete: Cascade)
  owner    User     @relation("InquiryReceiver", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([seekerId])
  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
}

model VisitRequest {
  id          String      @id @default(uuid())
  propertyId  String
  seekerId    String
  ownerId     String
  preferredAt DateTime
  note        String?     @db.Text
  status      VisitStatus @default(REQUESTED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  seeker   User     @relation("VisitSender", fields: [seekerId], references: [id], onDelete: Cascade)
  owner    User     @relation("VisitReceiver", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([seekerId])
  @@index([ownerId])
  @@index([status])
}

model Call {
  id         String     @id @default(uuid())
  callerId   String
  receiverId String
  propertyId String?
  roomId     String     @unique
  status     CallStatus @default(INITIATED)
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime   @default(now())

  caller   User      @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  receiver User      @relation("CallReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([callerId])
  @@index([receiverId])
  @@index([propertyId])
  @@index([status])
  @@index([createdAt])
}

model VerificationRequest {
  id           String             @id @default(uuid())
  userId       String             @unique
  documentType DocumentType
  documentUrl  String
  status       VerificationStatus @default(PENDING)
  adminNote    String?            @db.Text
  createdAt    DateTime           @default(now())
  reviewedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
}

model Agreement {
  id               String           @id @default(uuid())
  propertyId       String
  ownerId          String
  tenantId         String
  rent             Float
  deposit          Float
  startDate        DateTime
  endDate          DateTime
  noticePeriodDays Int
  termsText        String           @db.Text
  status           AgreementStatus  @default(DRAFT)
  pdfUrl           String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  property   Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  owner      User                   @relation("AgreementOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  tenant     User                   @relation("AgreementTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  signatures AgreementSignature[]

  @@index([propertyId])
  @@index([ownerId])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

model AgreementSignature {
  id            String   @id @default(uuid())
  agreementId   String
  userId        String
  signatureData String   @db.Text
  signedAt      DateTime @default(now())

  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([agreementId])
  @@index([userId])
}

model Mover {
  id          String  @id @default(uuid())
  name        String
  rating      Float   @default(0)
  reviewCount Int     @default(0)
  phone       String?
  description String? @db.Text
  isActive    Boolean @default(true)

  quotes   MoverQuote[]
  bookings MoverBooking[]
}

model MovingRequest {
  id           String               @id @default(uuid())
  userId       String
  origin       String
  destination  String
  moveDate     DateTime
  propertySize String
  notes        String?              @db.Text
  status       MovingRequestStatus  @default(PENDING)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items    MovingItem[]
  quotes   MoverQuote[]
  bookings MoverBooking[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model MovingItem {
  id               String  @id @default(uuid())
  movingRequestId  String
  name             String
  quantity         Int     @default(1)
  notes            String?

  movingRequest MovingRequest @relation(fields: [movingRequestId], references: [id], onDelete: Cascade)

  @@index([movingRequestId])
}

model MoverQuote {
  id              String            @id @default(uuid())
  movingRequestId String
  moverId         String
  price           Float
  estimatedHours  Int
  inclusions      String            @db.Text
  status          MoverQuoteStatus  @default(SENT)
  createdAt       DateTime          @default(now())

  movingRequest MovingRequest  @relation(fields: [movingRequestId], references: [id], onDelete: Cascade)
  mover         Mover          @relation(fields: [moverId], references: [id], onDelete: Cascade)
  bookings      MoverBooking[]

  @@index([movingRequestId])
  @@index([moverId])
  @@index([status])
}

model MoverBooking {
  id              String        @id @default(uuid())
  movingRequestId String
  moverId         String
  quoteId         String
  scheduledAt     DateTime
  status          BookingStatus @default(CONFIRMED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  movingRequest MovingRequest @relation(fields: [movingRequestId], references: [id], onDelete: Cascade)
  mover         Mover         @relation(fields: [moverId], references: [id], onDelete: Cascade)
  quote         MoverQuote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([movingRequestId])
  @@index([moverId])
  @@index([status])
}

model Reminder {
  id        String       @id @default(uuid())
  userId    String
  type      ReminderType
  title     String
  dueDate   DateTime
  amount    Float?
  notes     String?      @db.Text
  completed Boolean      @default(false)
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([dueDate])
  @@index([completed])
}

model PremiumOrder {
  id           String              @id @default(uuid())
  userId       String
  propertyId   String
  amount       Float
  durationDays Int
  status       PremiumOrderStatus  @default(PENDING)
  activatedAt  DateTime?
  expiresAt    DateTime?
  createdAt    DateTime            @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([propertyId])
  @@index([status])
}

model Report {
  id             String       @id @default(uuid())
  reporterId     String
  propertyId     String?
  reportedUserId String?
  reason         String
  description    String       @db.Text
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now())

  reporter     User      @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  property     Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  reportedUser User?     @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([propertyId])
  @@index([reportedUserId])
  @@index([status])
}

model InAppNotification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @db.Text
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
}

model AuditLog {
  id         String    @id @default(uuid())
  adminId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime  @default(now())

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}
